---
const tariffs = [
  { label: "Asosiy (chiqish) narxi", value: "8 000 so'm" },
  { label: "Har bir kilometr", value: "2 500 so'm" },
  { label: "Minimal safar narxi", value: "10 000 so'm" },
  { label: "Kutish", value: "5 daqiqa bepul, keyin 500 so'm/daqiqa" },
  { label: "Bagaj", value: "3 000 so'm" },
  { label: "Tungi tarif", value: "22:00–06:00 — narxga 500 so'm qo'shiladi" },
];

const places = [
  "Bandixon bozori",
  "Tuman hokimligi",
  "Markaziy masjid",
  "Bandixon tumani markazi",
  "Tuman ichidagi qishloqlar",
];
---
<section id="narxlar" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Narxlar</span>
      <h2>Aniq tarif — <span class="accent">yo'lda savol yo'q</span></h2>
      <p>
        Barcha safarlar bitta oddiy formulas asosida hisoblanadi: chiqish narxi + kilometr bo'yicha.
        Yakuniy narx 500 so'mga yaxlitlanadi va safar boshlanishidan oldin aytiladi.
      </p>
    </div>
    <div class="pricing-grid">
      <div class="card tariff-card reveal">
        <h3>Tariflar</h3>
        <dl class="tariff-list">
          {tariffs.map((t) => (
            <div class="tariff-row">
              <dt>{t.label}</dt>
              <dd>{t.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="card reveal">
        <h3>Mashhur manzillar</h3>
        <p>Quyidagi manzillarga safarlar eng tez-tez buyurtma qilinadi:</p>
        <ul class="places-list">
          {places.map((place) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              {place}
            </li>
          ))}
        </ul>
        <p class="price-note">
          Xizmat faqat Bandixon tumani hududida — markazi va qishloqlari bilan birga.
        </p>
      </div>
    </div>
  </div>
</section>
