---
const services = [
  {
    title: "Tuman ichida safarlar",
    text: "Bandixon tumani markazi va barcha qishloqlari bo'ylab qat'iy tarif bilan safarlar. Narx safar boshlanishidan oldin aniq aytiladi.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5 13.8 13.8 8.5 15.5l1.7-5.3z"/>',
  },
  {
    title: "Telefon orqali buyurtma",
    text: "+998 91 000 44 55 raqamiga qo'ng'iroq qiling — operator manzilingizni yozib, eng yaqin bo'sh haydovchini yo'naltiradi.",
    icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
  },
  {
    title: "Telegram bot orqali buyurtma",
    text: "@janubtaxibot orqali bir necha soniyada buyurtma bering — bot narxni darhol hisoblab, haydovchini tasdiqlaydi.",
    icon: '<path d="M9.04 15.5 8.9 19c.42 0 .6-.18.83-.4l2-1.9 4.13 3.03c.76.42 1.3.2 1.5-.7l2.72-12.8c.24-1.1-.4-1.53-1.14-1.26L3.6 11.23c-1.08.42-1.07 1.02-.18 1.3l3.8 1.18 8.83-5.56c.42-.25.8-.12.5.14l-7.5 6.7Z"/>',
  },
  {
    title: "Bagaj va yuk tashish",
    text: "Sumka, qadoq yoki kichik yuklaringizni xavfsiz yetkazib beramiz. Bagaj xizmati atigi 3 000 so'm.",
    icon: '<path d="M6 7h12l1.5 13h-15L6 7Zm3 0a3 3 0 0 1 6 0"/>',
  },
  {
    title: "Tungi xizmat 20:00–06:00",
    text: "Tungi soatlarda ham ishlaymiz — tungi tarifning yagoni farqi: yakuniy narxga 500 so'm qo'shiladi, qolgani o'zgarishsiz.",
    icon: '<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/>',
  },
  {
    title: "24/7 ish rejimi",
    text: "Bayram, dam olish kuni yoki tun yorug'ida — Janub Taxi har doim aloqada. Mashina kerak bo'lgan har qanday vaqtda qo'ng'iroq qiling.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  },
];
---
<section id="xizmatlar" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Xizmatlar</span>
      <h2>Bandixon uchun <span class="accent">to'liq taksi xizmati</span></h2>
      <p>Tuman aholisiga qulay bo'lish uchun barcha buyurtma usullari ochiq: telefon, Telegram bot — ikkalasi bir xil tez va ishonchli.</p>
    </div>
    <div class="grid grid-3">
      {services.map((service) => (
        <article class="card reveal">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={service.icon} />
          </div>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
