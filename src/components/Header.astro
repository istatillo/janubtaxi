---
const navLinks = [
  { href: '#xizmatlar', label: 'Xizmatlar' },
  { href: '#yonalishlar', label: "Yo'nalishlar" },
  { href: '#qanday-ishlaydi', label: 'Qanday ishlaydi' },
  { href: '#faq', label: 'FAQ' },
  { href: '#aloqa', label: 'Aloqa' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="#" class="brand" aria-label="Janub Taxi — bosh sahifa">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="#FFC61A"/>
        <path d="M10 26 L16 15 C17.3 12.8 19.2 12 21.5 12 H42.5 C44.8 12 46.7 12.8 48 15 L54 26 Z" fill="#0B0B0F"/>
        <rect x="8" y="26" width="48" height="18" rx="4" fill="#0B0B0F"/>
        <rect x="10" y="30" width="7" height="4" fill="#FFC61A"/>
        <rect x="19" y="30" width="7" height="4" fill="#0B0B0F"/>
        <rect x="28" y="30" width="7" height="4" fill="#FFC61A"/>
        <rect x="37" y="30" width="7" height="4" fill="#0B0B0F"/>
        <rect x="46" y="30" width="7" height="4" fill="#FFC61A"/>
        <rect x="10" y="36" width="7" height="4" fill="#0B0B0F"/>
        <rect x="19" y="36" width="7" height="4" fill="#FFC61A"/>
        <rect x="28" y="36" width="7" height="4" fill="#0B0B0F"/>
        <rect x="37" y="36" width="7" height="4" fill="#FFC61A"/>
        <rect x="46" y="36" width="7" height="4" fill="#0B0B0F"/>
        <circle cx="20" cy="46" r="6" fill="#1A1A22" stroke="#FFC61A" stroke-width="2"/>
        <circle cx="44" cy="46" r="6" fill="#1A1A22" stroke="#FFC61A" stroke-width="2"/>
      </svg>
      Janub&nbsp;Taxi
    </a>
    <nav class="main-nav" aria-label="Asosiy navigatsiya">
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <a class="btn btn-primary header-cta" href="https://t.me/janubtaxibot" target="_blank" rel="noopener">
      Botni ochish
    </a>
  </div>
</header>
