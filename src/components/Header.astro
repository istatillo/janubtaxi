---
const navLinks = [
  { href: '#xizmatlar', label: 'Xizmatlar' },
  { href: '#qanday-ishlaydi', label: 'Qanday ishlaydi' },
  { href: '#aloqa', label: 'Aloqa' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="#" class="brand" aria-label="Janub Taxi — bosh sahifa">
      <img src="/logo-white.png" alt="" width="36" height="36" />
      <span>Janub&nbsp;Taxi</span>
    </a>
    <nav class="main-nav" aria-label="Asosiy navigatsiya">
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <a class="btn btn-primary header-cta" href="tel:+998910004455">
      Qo'ng'iroq qilish
    </a>
  </div>
</header>
