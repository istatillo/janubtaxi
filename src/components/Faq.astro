---
const faqs = [
  {
    q: "Narx qanday hisoblanadi?",
    a: "Safar narxi oddiy formula asosida hisoblanadi: 8 000 so'm chiqish narxi + har kilometr uchun 2 500 so'm. Yakuniy summa 500 so'mga yaxlitlanadi va safar boshlanishidan oldin aniq aytiladi — yo'lda narx oshmaydi.",
  },
  {
    q: "Minimal safar narxi qancha?",
    a: "Qat'iy qisqa safarlar uchun minimal narx 10 000 so'm belgilangan. Formula bo'yicha hisoblangan narx bundan past bo'lsa ham, to'lov 10 000 so'mdan kam bo'lmaydi.",
  },
  {
    q: "Tungi tarif bormi?",
    a: "Ha, 22:00 dan 06:00 gacha bo'lgan tungi soatlarda xizmat ishlaydi va yakuniy narxga atigi 500 so'm qo'shiladi. Tarifning qolgan qismi kunlikidan farq qilmaydi.",
  },
  {
    q: "Bagaj uchun qancha to'lanadi?",
    a: "Bagaj yoki kichik yuk uchun qo'shimcha 3 000 so'm olinadi. Bu summa buyurtma berishda darhol aytiladi — yashirin to'lovlar yo'q.",
  },
  {
    q: "Qishloqlarga ham xizmat bormi?",
    a: "Albatta. Janub Taxi butun Bandixon tumani hududida — markazi va unga qarashli barcha qishloqlarda ishlaydi. Narx masofaga qarab shu tarif asosida hisoblanadi.",
  },
  {
    q: "Buyurtmani qanday beraman?",
    a: "Ikki yo'l bor: +998 91 000 44 55 raqamiga qo'ng'iroq qiling yoki Telegramda @janubtaxibot ni oching va manzilni yozing. Ikkala usulda ham eng yaqin haydovchi bir necha daqiqada yo'naladi.",
  },
];
---
<section id="faq" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Savol-javoblar</span>
      <h2>Ko'p so'raladigan <span class="accent">savollar</span></h2>
    </div>
    <div class="faq-list reveal">
      {faqs.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
