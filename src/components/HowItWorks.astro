---
const steps = [
  {
    num: "01",
    title: "Buyurtma bering",
    text: "Telefon (+998 91 000 44 55) qo'ng'irog'i yoki Telegram bot (@janubtaxibot) orqali qayerdan va qayerga borishingizni ayting. Ikkala usul ham bir xil tez ishlaydi.",
  },
  {
    num: "02",
    title: "Eng yaqin haydovchi yo'naladi",
    text: "Operator yoki bot tuman ichidagi eng yaqin bo'sh haydovchini aniqlaydi va darhol sizning manzilingizga yo'naltiradi. Narx kelishiladi.",
  },
  {
    num: "03",
    title: "Xavfsiz safar",
    text: "Haydovchi yetib kelganda yo'lga chiqing. To'lov safar oxirida naqd pulda qilinadi — narx oldindagidan ortiq chiqmaydi.",
  },
];
---
<section id="qanday-ishlaydi" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Jarayon</span>
      <h2>Mashina chaqirish — <span class="accent">3 oddiy qadam</span></h2>
      <p>Ro'yxatdan o'tish va uzoq kutilishlar kerak emas. Qo'ng'iroq yoki bot — va mashina yo'lda.</p>
    </div>
    <div class="grid grid-3">
      {steps.map((step) => (
        <article class="card reveal">
          <div class="step-num">{step.num}</div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
